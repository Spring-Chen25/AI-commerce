# 复制为 .env 后按需修改（不要提交真实密钥）
APP_NAME=ai_ecommerce
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
# 多个 origin 用英文逗号分隔；国内直连可填 "*"
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- ORM 默认业务库（同步引擎，走 psycopg3；与下方 asyncpg 连接器指向同库、驱动各司其职）---
# 本地无 PG 时可临时改回：sqlite:///./ai_ecommerce.db
DATABASE_URL=postgresql+psycopg://<user>:<pwd>@<host>:5432/<db>

# --- 外部连接（URL 形式；留空 = 未启用，连接器 health() 返回 disabled）---
# MySQL：密码含 @ / : / # 等特殊字符时必须做 URL 编码（@ → %40）
MYSQL_URL=mysql+pymysql://<user>:<pwd>@<host>:3306/<db>?charset=utf8mb4
# PostgreSQL：异步连接器专用（asyncpg）
POSTGRES_URL=postgresql+asyncpg://<user>:<pwd>@<host>:5432/<db>
# Redis：无用户名用 redis://:<pwd>@host:6379/0
REDIS_URL=redis://:<pwd>@<host>:6379/0
# MinIO（secure=false 即 HTTP）
MINIO_ENDPOINT=<host>:9100
MINIO_ACCESS_KEY=<access_key>
MINIO_SECRET_KEY=<secret_key>
MINIO_BUCKET=<bucket>
MINIO_SECURE=false
# Milvus：未启用认证时 user/password 留空
MILVUS_HOST=<host>
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# --- Celery（broker/backend 走 Redis；留空 = 未启用）---
# 建议用不同 db 与缓存隔离：broker=db/1、backend=db/2
CELERY_BROKER_URL=redis://:<pwd>@<host>:6379/1
CELERY_RESULT_BACKEND=redis://:<pwd>@<host>:6379/2

# --- 日志 ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- JWT（生产务必替换为强随机密钥）---
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-dedicated-32-byte-secret
